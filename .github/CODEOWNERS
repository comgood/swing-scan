# Lane ownership from doc 02 section 15.2. All lanes run under one account, so every path resolves to the owner;
# the lane comments say which agent writes there.

# Default: the owner reviews everything.
*                         @comgood

# Owner only, never edited by agents (also guarded by pre-commit and the CI label check).
/tests/oracle/            @comgood

# DI lane: root config, CI, infra, data generation.
/Makefile                 @comgood
/pyproject.toml           @comgood
/package.json             @comgood
/.pre-commit-config.yaml  @comgood
/.github/                 @comgood
/infra/                   @comgood
/scripts/                 @comgood

# BE lane: engine domain modules and the API.
/engine/                  @comgood
/services/api/            @comgood
# DI owns these (listed after /engine/ and /services/api/ because the last match wins).
/services/api/Dockerfile  @comgood
/engine/src/engine/synthetic/  @comgood
/engine/src/engine/data/  @comgood

# FE lane: the web app.
/apps/web/                @comgood

# QA lane: acceptance tests, golden references, test plan.
/tests/acceptance/        @comgood
/tests/golden/            @comgood
/apps/web/tests/acceptance/  @comgood
/docs/qa/                 @comgood

# Contracts: owner approves every change (contract-change PRs).
/contracts/               @comgood
/packages/api-client/     @comgood
