# Copy to .env for local overrides. Never commit .env (it is gitignored).

# Web app: where the browser calls the API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# 1 answers API calls in the browser from contracts/mocks/ through MSW (spec 0002).
# Unset or 0 in production. `pnpm --filter web dev:mock` sets it for you.
NEXT_PUBLIC_API_MOCK=0

# API: "synthetic" (default, the only mode allowed in the cloud) or "live". Live starts only on
# your machine, bound to 127.0.0.1, never on Lambda or in CI (D-5). `make dev-live` sets it.
DATA_MODE=synthetic
# The dataset root the API reads (spec 0011). The mode above picks the prefix under it, so
# this plus DATA_MODE=synthetic reads ./data/synthetic. Set it to s3://<bucket> to read the
# store; `make dev` points it at MinIO instead (see below).
MARKET_STORE_URI=./data

# Local only, for saved rules (scope feature 21, spec 0014). Absent means the rules endpoints
# answer 501 and the web app hides the save control, which is also how the deployed API runs:
# there are no accounts yet, so there is no public write path. Never put these in CI, the image
# or the repo. Postgres on Neon; any Postgres works, the code only sees the URL.
# DATABASE_URL is the POOLED string (its host contains `-pooler`): PgBouncer in transaction
# mode, right for per request app traffic. DATABASE_URL_UNPOOLED is the direct one, used only
# by Alembic, because migrations need session state the pooler cannot keep across checkouts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# API CORS: exact origins, plus an optional pattern for Vercel preview URLs.
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGIN_REGEX=

# Local only, for `make load-live` (scope feature 14, Alpaca free plan). Never put these in CI,
# the image or the repo. The universe CSV (ticker,name,sector) goes in research/sp500.csv.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Which Alpaca feed the loader reads: "iex" (default, what the free Basic plan serves) or "sip"
# (the full consolidated tape, paid plans only; on a free key it answers HTTP 403). The CLI flag
# `--feed` overrides this. Research honesty: IEX is a single exchange and a small share of
# consolidated volume, so volume based rules (vol_ratio, avg_volume) and any comparison of
# volume across tickers are NOT comparable to a full tape. Price based rules are unaffected.
ALPACA_FEED=iex
